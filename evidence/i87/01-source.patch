+def declared_features(profile):
+    """The `features:` block, validated against the allow-list and normalised.
+
+    Returns {name: decl} for every feature the profile turns ON, {} when it
+    declares none. Each decl has already been through that module's declare().
+
+    ALLOW-LISTING IS NOT OPTIONAL, and the reason is measured: nothing in the
+    profile path rejects an unknown key. gpufab.load_profile deep-merges over
+    DEFAULTS and copies unknown keys through; validate_profile only runs on the
+    legacy shape; derive() raises only on impossible topologies. So a typo'd
+    `vxlann:` — or `evpnn:` — would be read by every consumer as "no such
+    feature is on", silently, while its author believed the overlay was
+    configured and the fabric rendered without it.
+
+    The allow-list is COMPUTED from tools/features/*.py, never maintained. A new
+    module registers itself by existing; there is no second list to update, so
+    there is no second list to forget.
+    """
+    block = profile.get("features")
+    if block in (None, {}, False):
+        return {}
+    if not isinstance(block, dict):
+        raise ModelError(
+            f"`features:` must be a mapping of feature-name -> settings, got "
+            f"{type(block).__name__}")
+
+    known = features.discover()
+    unknown = [k for k in block if k not in known]
+    if unknown:
+        raise ModelError(
+            f"profile declares unknown feature(s) {sorted(unknown)}. Known "
+            f"features: {list(features.names())} (one file each in "
+            f"tools/features/). An unknown feature name is refused rather than "
+            f"ignored: an ignored one reads as 'off' everywhere while its "
+            f"author believes it is on.")
+
+    out = {}
+    for name, mod in sorted(known.items()):
+        decl = mod.declare(profile, error=ModelError)
+        if decl:
+            out[name] = decl
+    return out
+
