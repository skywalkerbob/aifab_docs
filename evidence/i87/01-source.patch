+"""evpn — an EVPN/VXLAN overlay on the FRONTEND fabric.
+
+KIND: config-only. It adds tables to devices the topology already contains; it
+adds no device, no link and no clab node, so §5.10/gen_topology are untouched.
+(FEATURE-EXTENSIBILITY §6.4 requires a module to say which kind it is.)
+
+THE MODULE IS CALLED `evpn`, NOT `vxlan`, AND THAT IS LOAD-BEARING.
+The `vxlan` token already belongs to the SIMULATOR'S OWN TRANSPORT:
+clab/gen_topology._vni() allocates `100 + sha256(...) % 16_000_000` for
+cross-host link transport on UDP 14789, clab/reconcile.py:121-128,364-373
+partitions local from remote links on `type == "vxlan"`, and
+tests/t25-reconcile.sh:100,202 counts `!= "vxlan"` to avoid double-counting the
+two topology entries a cross-host link produces. Taking the token back would
+corrupt three working measurements. The two encapsulations never meet: the
+substrate rides UDP 14789 between fabric HOSTS, this one rides UDP 4789 between
+simulated switch loopbacks.
+
+WHICH FABRIC CARRIES IT — frontend. See the module's `FABRICS_DEFAULT` note.
+
+THE FIDELITY CEILING, STATED RATHER THAN DISCOVERED
+MEASURED on gpufab-s11 2026-07-28: the switches run `asic_type: vs`,
+`docker-syncd-vs`, i.e. libsai_vs — a SOFTWARE dataplane. VXLAN state programs
+faithfully all the way into ASIC_DB, and there is no VXLAN encap/decap
+forwarding behind it. So `observe()` verifies that orchagent asked SAI to build
+a VXLAN tunnel object; it does NOT and must not claim a frame crossed one.
+FEATURE-EXTENSIBILITY §5.6 is explicit about this case: verify at the deepest
+layer that IS observable and record the limitation, "rather than passing on
+config_db alone and calling it working". A capture-based proof (the FV-CAP-02
+pattern) is meaningless on this image and is deliberately not attempted.
+
+The image itself is capable: `vxlanmgrd RUNNING` in swss,
+/usr/local/yang-models/sonic-vxlan.yang present and declaring exactly the three
+tables below, `show vxlan tunnel|remotevtep|vlanvnimap` all rc=0, and FRR 10.3
+answering `show bgp l2vpn evpn summary`. Recorded in nos_catalog as measured.
+
+WHAT THIS MODULE DOES NOT EMIT, AND WHY IT IS NOT A BUG
+VLAN_MEMBER is absent. Binding a host-facing front-panel port into a VLAN needs
+the port-assignment map, which lives in the RENDERER (render_fabric_ztp resolves
+NetBox interfaces to Ethernet<n> through interim_deploy.vm_port), not in the
+model. `config_db(device, model, alloc)` is handed a model device and has no
+port names to be correct about. Emitting a guessed port name here would be a
+second derivation of a value the renderer owns — the #79 shape this interface
+exists to prevent. The tunnel and the VLAN-to-VNI mapping do not depend on it:
+vxlanmgrd programs a VTEP from VXLAN_TUNNEL + VXLAN_TUNNEL_MAP whether or not a
+port is a member, so the tier-2 proof is unaffected. Recorded in UNVERIFIED-
+style prose rather than left to be discovered.
+"""
+from __future__ import annotations
+
+NAME = "evpn"
+
+# Keys in nos_catalog capabilities. A NOS that does not declare BOTH true is
+# refused at derive time by fabric_model.check_nos_capabilities().
+REQUIRES = ("vxlan_dataplane", "evpn_control_plane")
+
+# Identifier namespaces this module claims. Declared so that a second module
+# claiming `vni` is a visible conflict rather than a silent overlap.
+POOLS = ("vni", "vlan")
+
+# The profile block's shape. Any key not named here is refused BY NAME.
+SCHEMA = {"fabrics": list, "segments": list, "vni_base": int, "anycast_gw": bool}
+
+# Frontend, and the word is "fabric" not "plane" (§5.1). Four reasons, each
+# checkable against this repository rather than against vendor documentation:
+#
+#  1. The backend is pure L3 by design AND by measurement — rail-optimised /31 +
+#     eBGP + ECMP, converging 1464/1464 with no overlay. An overlay there adds
+#     encapsulation to RoCE traffic whose entire point is that it has none.
+#     gpufab-sim-design.md:227 records it as risk R3, "Designed out".
+#  2. Storage is the same pattern plus a service VIP (10.255.2.100/32) advertised
+#     by the active DDN controller — anycast that already works without an
+#     overlay, on links that are equally latency- and loss-sensitive.
+#  3. The frontend is the ONLY fabric that already carries L2. s1-512.yaml
+#     declares `frontend: {leaves: 3, spines: 2, peer_links: 1}`; storage
+#     declares no peer_links, because only a single-active SVI gateway needs one.
+#     That peer link is a structural signal in the profile itself.
+#  4. design/policy/addressing.yaml already declares `frontend_vlans` — VLAN 100
+#     compute and VLAN 200 provisioning, with prefixes and gateways — and
+#     MEASURED: nothing in either repo reads it. Grepped 2026-07-28, zero hits
+#     outside t01-provenance's checksum sweep. A declared policy nothing consumes
+#     is worse than none.
+#
+# The default is not a restriction: a profile may name any fabric, including
+# backend. A simulator must reproduce what a customer might do, including the
+# unwise. The model refuses combinations that are IMPOSSIBLE, not inadvisable.
+FABRICS_DEFAULT = ("frontend",)
+
+# Named here rather than imported from fabric_model, which imports THIS package
+# and would make the cycle. One tuple, and declare() checks against it so a
+# typo'd fabric is a named error instead of a silent zero-device selection.
+_FABRICS = ("backend", "frontend", "storage", "oob")
+
+# VNIs are the low, readable band a real deployment uses: vni = VNI_BASE + vlan,
+# so VLAN 100 is 10100. Disjointness from the substrate's own VNI band
+# ([100, 16_000_099], see gen_topology._vni) is NOT asserted, deliberately: the
+# two live on different UDP ports between different endpoints and cannot collide
+# on the wire. Asserting a constraint that does not exist would be a check that
+# measures nothing, which is the thing this project keeps building.
+VNI_BASE_DEFAULT = 10_000
+
+_VNI_MAX = 1 << 24          # VXLAN's 24-bit VNI field; hard wire-format limit
+_VLAN_MIN, _VLAN_MAX = 2, 4094   # 1 is default, 4095 reserved
+
+
+class _Err(Exception):
+    """Raised as fabric_model.ModelError by the caller; see declare()."""
+
+
+def declare(profile, error=_Err):
+    """Validate and normalise this feature's profile block.
+
+    Returns {} when the feature is absent or explicitly off, so every existing
+    profile renders byte-identically. An unknown key INSIDE the block raises,
+    naming it and listing the legal set — because unknown profile keys are
+    otherwise ignored without complaint, and a typo'd `segement:` would read as
+    "no segments" while its author believed the overlay was configured.
+
+    `error` is injected so this module needs no import from fabric_model, which
+    would be circular: fabric_model imports features, not the reverse.
+    """
+    block = ((profile.get("features") or {}).get(NAME))
+    if block in (None, False):
+        return {}
+    if block is True:
+        raise error(
+            f"features.{NAME} is `true` with no body. This feature needs at "
+            f"least `segments:`; a bare toggle would render an overlay with "
+            f"nothing in it and report success.")
+    if not isinstance(block, dict):
+        raise error(f"features.{NAME} must be a mapping, got {type(block).__name__}")
+
+    unknown = [k for k in block if k not in SCHEMA]
+    if unknown:
+        raise error(
+            f"features.{NAME} names unknown key(s) {sorted(unknown)} "
+            f"(known: {sorted(SCHEMA)}). Unknown profile keys are otherwise "
+            f"ignored silently, so a typo reads as 'off' while looking on.")
+    for k, want in SCHEMA.items():
+        if k in block and not isinstance(block[k], want):
+            raise error(
+                f"features.{NAME}.{k} must be {want.__name__}, got "
+                f"{type(block[k]).__name__}")
+
+    fabrics = tuple(block.get("fabrics") or FABRICS_DEFAULT)
+    if not fabrics:
+        raise error(f"features.{NAME}.fabrics is empty — name at least one fabric")
+    bad = [f for f in fabrics if f not in _FABRICS]
+    if bad:
+        raise error(
+            f"features.{NAME}.fabrics names {sorted(bad)}, which is not a "
+            f"fabric (known: {list(_FABRICS)}). A typo here selects no device "
+            f"and the overlay renders nowhere.")
+    # REFUSING oob IS A CORRECTNESS RULE, NOT TASTE, and it was found by a
+    # control rather than by reading. MEASURED: the two OOB switches carry
+    # tier="leaf" and a loopback, so the tier-based VTEP selection below
+    # matched them and this module rendered a full VXLAN overlay onto the
+    # fabric's two MANAGEMENT switches — which have no p2p links, no BGP
+    # session, an empty INTERFACE table, and are excluded from the 46 the push
+    # manages. derive() itself skips oob when assigning p2p addressing
+    # ("oob is L2/mgmt, not a routed p2p"), so a VTEP there has no routed
+    # underlay to source from and no remote VTEP could ever reach it.
+    #
+    # §5.1 requires the mechanism to permit `fabrics: [backend]` — a customer
+    # may do something unwise and a simulator must reproduce it. This is the
+    # other category: impossible, not inadvisable. backend stays permitted.
+    if "oob" in fabrics:
+        raise error(
+            f"features.{NAME}.fabrics names 'oob'. The OOB fabric is an "
+            f"unrouted L2 management segment — derive() gives its links no /31 "
+            f"and its switches no BGP session — so a VTEP there has no "
+            f"underlay to source a tunnel from. This is refused as impossible, "
+            f"not discouraged as unwise; 'backend' remains permitted.")
+
+    raw = block.get("segments")
+    if not raw:
+        raise error(
+            f"features.{NAME} declares no segments. An overlay with no segment "
+            f"renders VXLAN_TUNNEL and nothing to carry, and every count the "
+            f"oracle derives would be zero — which t_count would pass (0/0).")
+
+    segs, seen_vlan, seen_name = [], {}, {}
+    for i, s in enumerate(raw):
+        if not isinstance(s, dict):
+            raise error(f"features.{NAME}.segments[{i}] must be a mapping")
+        extra = [k for k in s if k not in ("name", "vlan", "prefix")]
+        if extra:
+            raise error(
+                f"features.{NAME}.segments[{i}] names unknown key(s) "
+                f"{sorted(extra)} (known: ['name', 'prefix', 'vlan'])")
+        name = str(s.get("name") or "").strip()
+        if not name:
+            raise error(f"features.{NAME}.segments[{i}] has no name")
+        if name in seen_name:
+            raise error(
+                f"features.{NAME}: segment name {name!r} declared twice "
+                f"(indices {seen_name[name]} and {i})")
+        seen_name[name] = i
+        try:
+            vlan = int(s["vlan"])
+        except (KeyError, TypeError, ValueError):
+            raise error(
+                f"features.{NAME}.segments[{i}] ({name}) has no integer `vlan`")
+        if not (_VLAN_MIN <= vlan <= _VLAN_MAX):
+            raise error(
+                f"features.{NAME}: segment {name!r} vlan {vlan} outside "
+                f"{_VLAN_MIN}..{_VLAN_MAX} (1 is the default VLAN, 4095 reserved)")
+        if vlan in seen_vlan:
+            raise error(
+                f"features.{NAME}: vlan {vlan} declared by both "
+                f"{seen_vlan[vlan]!r} and {name!r}. Two segments on one VLAN "
+                f"would map two VNIs onto one broadcast domain.")
+        seen_vlan[vlan] = name
+        segs.append({"name": name, "vlan": vlan,
+                     "prefix": str(s["prefix"]).strip() if s.get("prefix") else None})
+
+    vni_base = int(block.get("vni_base", VNI_BASE_DEFAULT))
+    if vni_base < 1:
+        raise error(f"features.{NAME}.vni_base must be >= 1, got {vni_base}")
+
+    return {"fabrics": fabrics,
+            "segments": segs,
+            "vni_base": vni_base,
+            "anycast_gw": bool(block.get("anycast_gw", False))}
+
+
+def allocate(model, decl, error=_Err):
+    """Every identifier this feature needs. THE ONLY PLACE A VNI IS COMPUTED.
+
+    Two derivations of one value is the defect this project has produced three
+    times (#79, and the two the comment above that call site names). Every
+    consumer — the composer, the oracle, the device check — reads the dict this
+    returns; none of them recomputes `vni_base + vlan`, and there is no second
+    expression anywhere that could disagree.
+
+    `vtep_src` REFERENCES device["loopback"], which Addressing.loopback() owns.
+    It is not recomputed here even though the arithmetic would be easy, because
+    a module that recomputes a model-owned value — even correctly — is #79.
+    """
+    if not decl:
+        return {}
+
+    prof = model.get("profile") or {}
+    envelope = ((prof.get("addressing") or {}).get("envelope") or {})
+    # Bound comes from the DECLARED envelope, exactly like every other pool in
+    # this model: exceeding it is a named error, never a silent renumber, so
+    # growing the overlay is a reviewed decision rather than a side effect.
+    cap = envelope.get("vni")
+    segs = decl["segments"]
+    if cap is not None and len(segs) > int(cap):
+        raise error(
+            f"features.{NAME} declares {len(segs)} segments but "
+            f"addressing.envelope.vni is {cap}. Raise the envelope in the "
+            f"profile. Widening it is safe for VNIs (they are positional on "
+            f"vlan id, not sequential), but it is declared so the growth is "
+            f"visible rather than inferred.")
+
+    base = decl["vni_base"]
+    segments = []
+    for s in segs:
+        vni = base + s["vlan"]          # <- THE derivation. One expression.
+        if not (0 < vni < _VNI_MAX):
+            raise error(
+                f"features.{NAME}: segment {s['name']!r} vlan {s['vlan']} with "
+                f"vni_base {base} gives VNI {vni}, outside VXLAN's 24-bit field "
+                f"(1..{_VNI_MAX - 1}). Lower features.{NAME}.vni_base.")
+        gw = None
+        if decl["anycast_gw"]:
+            if not s["prefix"]:
+                raise error(
+                    f"features.{NAME}: anycast_gw is on but segment "
+                    f"{s['name']!r} declares no `prefix`, so there is no "
+                    f"network to put a gateway on.")
+            gw = _first_host(s["prefix"], error)
+        segments.append({"name": s["name"], "vlan": s["vlan"], "vni": vni,
+                         "prefix": s["prefix"], "anycast_gw": gw,
+                         "vlan_if": f"Vlan{s['vlan']}"})
+
+    vteps = sorted(d["name"] for d in model.get("devices", [])
+                   if _is_vtep(d, decl))
+    if not vteps:
+        raise error(
+            f"features.{NAME} is enabled on fabrics {list(decl['fabrics'])} but "
+            f"that selects zero VTEP devices in this topology. A feature that "
+            f"renders nothing anywhere is a profile error, not a no-op: every "
+            f"derived count would be zero and every 0/0 assertion would pass.")
+
+    return {"segments": segments, "vteps": vteps,
+            "transits": sorted(d["name"] for d in model.get("devices", [])
+                               if _is_transit(d, decl)),
+            "vni_base": base, "fabrics": tuple(decl["fabrics"]),
+            "anycast_gw": decl["anycast_gw"]}
+
+
+def _first_host(prefix, error=_Err):
+    """The .1 of a segment prefix. One derivation, used for every consumer."""
+    import ipaddress
+    try:
+        net = ipaddress.ip_network(str(prefix), strict=False)
+    except ValueError as e:
+        raise error(f"features.{NAME}: bad segment prefix {prefix!r}: {e}")
+    if net.num_addresses < 4:
+        raise error(
+            f"features.{NAME}: segment prefix {prefix} is too small to host a "
+            f"gateway and any endpoints")
+    return f"{ipaddress.ip_address(int(net.network_address) + 1)}/{net.prefixlen}"
+
+
+def _is_vtep(device, decl):
+    """Leaves in the named fabrics terminate tunnels.
+
+    SELECTION IS BY MODEL FIELDS, never by name substring. fabric_model
+    recovers `plane` by matching '-p2-' inside a device name
+    (fabric_model.py:886-888, :1423-1432); that is a trap, not a pattern to
+    copy — it silently reclassifies any device whose name happens to contain
+    the token.
+    """
+    return (device.get("fabric") in decl["fabrics"]
+            and device.get("tier") == "leaf")
+
+
+def _is_transit(device, decl):
+    """Spines in the named fabrics carry EVPN routes but terminate no tunnel."""
+    return (device.get("fabric") in decl["fabrics"]
+            and device.get("tier") == "spine")
+
+
+def applies_to(device, model, decl):
+    """Does this module contribute anything to this device at all?"""
+    if not decl:
+        return False
+    return _is_vtep(device, decl) or _is_transit(device, decl)
+
+
+def config_db(device, model, alloc):
+    """Only the tables this module owns. The frr_render.to_config_db contract:
+    fragments for the caller to merge, never a copy of a whole config.
+
+    Spines get {} — they carry EVPN routes in FRR and terminate no tunnel, so
+    they own no config_db table. Returning {} rather than omitting the call is
+    deliberate: the composer then records honestly that evpn contributed nothing
+    here, instead of the device silently never being considered.
+    """
+    if not alloc or not _is_vtep(device, {"fabrics": alloc["fabrics"]}):
+        return {}
+
+    lo = device.get("loopback")
+    if not lo:
+        # Referenced, never recomputed — and refused rather than guessed. A
+        # VTEP with a source address this module invented would form tunnels
+        # nobody routes to, and every artifact-level check would agree it was
+        # configured correctly.
+        raise _Err(
+            f"features.{NAME}: {device.get('name')} is a VTEP but the model "
+            f"gives it no loopback. VXLAN_TUNNEL.src_ip must reference "
+            f"Addressing.loopback(); computing one here would be #79.")
+
+    vlan, vlan_if, tunnel_map = {}, {}, {}
+    for s in alloc["segments"]:
+        vlan[s["vlan_if"]] = {"vlanid": str(s["vlan"])}
+        if s["anycast_gw"]:
+            # SONiC models an SVI as two keys: the interface, and the interface
+            # with its prefix. Same shape INTERFACE/LOOPBACK_INTERFACE use.
+            vlan_if[s["vlan_if"]] = {}
+            vlan_if[f"{s['vlan_if']}|{s['anycast_gw']}"] = {}
+        tunnel_map[f"vtep|map_{s['vni']}_{s['vlan_if']}"] = {
+            "vni": str(s["vni"]), "vlan": s["vlan_if"]}
+
+    out = {
+        "VLAN": vlan,
+        "VXLAN_TUNNEL": {"vtep": {"src_ip": str(lo)}},
+        "VXLAN_EVPN_NVO": {"nvo": {"source_vtep": "vtep"}},
+        "VXLAN_TUNNEL_MAP": tunnel_map,
+    }
+    if vlan_if:
+        out["VLAN_INTERFACE"] = vlan_if
+    return out
+
+
+def frr_conf(device, model, alloc):
+    """Stanzas for the second artifact, where config_db cannot express it.
+
+    SONiC translates config_db -> FRR through bgpcfgd, and that translator is
+    the constraint, not FRR. config_db has no representation for an l2vpn evpn
+    address family, exactly as it has none for an interface-keyed BGP_NEIGHBOR
+    (upstream sonic-buildimage#26960) — which is why this project already ships
+    a rendered frr.conf and stage 55. The same seam carries this.
+
+    Spines need `route-target all` retention: on an eBGP EVPN underlay a spine
+    that does not import a route target discards routes it is supposed to
+    reflect, and the overlay silently loses remote VTEPs while every session
+    stays Established.
+    """
+    if not alloc:
+        return []
+    decl = {"fabrics": alloc["fabrics"]}
+    if _is_vtep(device, decl):
+        return ["  address-family l2vpn evpn",
+                "   advertise-all-vni",
+                "   advertise-default-gw" if alloc["anycast_gw"] else "   ! no anycast gw",
+                "  exit-address-family"]
+    if _is_transit(device, decl):
+        return ["  address-family l2vpn evpn",
+                # Not cosmetic: without this a spine drops what it should carry.
+                "   route-target all",
+                "  exit-address-family"]
+    return []
+
+
+def expected(model, alloc):
+    """Oracle entries. Each is {key, value, must, because}.
+
+    An entry with no `must` is REFUSED by expected.py, because a number nothing
+    compares is the exact shape of the defect that let
+    `max_ports_per_switch` print 70 against a 64-port platform and exit 0 for
+    the life of the project.
+
+    Every value is DERIVED — len(segments) x len(vteps) — never written down.
