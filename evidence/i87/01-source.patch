+++ b/gpufab-platform/tools/features/__init__.py
@@ -0,0 +1,85 @@
+"""Feature modules — capability declared in the profile instead of edited into code.
+
+WHY THIS PACKAGE LIVES IN gpufab-platform AND NOT gpufab-network
+----------------------------------------------------------------
+FEATURE-EXTENSIBILITY.md §3.2 names `gpufab-network/tools/features/`. It also
+says, in the same section, that "`declare`, `allocate` and `applies_to` run
+inside `fabric_model`" — and `fabric_model` is in gpufab-PLATFORM. Those two
+sentences cannot both be honoured, because the dependency between the repos
+runs one way only:
+
+    render_fabric_ztp.py:40-48   appends gpufab-platform/tools to sys.path and
+                                 imports fabric_model, gpufab, interim_deploy
+    gpufab-platform/tools/*      imports nothing from gpufab-network; it names
+                                 network paths as STRINGS for deploy stages
+                                 (gpufab.py:507-523), never as modules
+
+network -> platform is an established import. platform -> network is not one,
+and `expected.py` in particular sets sys.path to its own directory alone
+(expected.py:33), so it could not reach a module in the other repo at all.
+
+Four consumers must load a feature module: fabric_model (platform),
+expected.py (platform), the test suite (platform/tests), and the composer
+inside render_fabric_ztp (network — which already has platform/tools on its
+path). This directory is the only location all four reach without inverting the
+dependency arrow. Siting it in network would make `expected.py --key evpn_*`
+unresolvable, and the oracle half is the specific thing #56 was about.
+
+DISCOVERY IS A DIRECTORY SCAN, NOT A LIST
+-----------------------------------------
+The same rule render_revision.py uses for its data globs, for the reason it
+states: "a hardcoded list that silently stops covering a new data file is the
+same defect class this closes." Dropping a file in this directory registers it.
+There is no second place to remember, so there is no second place to forget.
+"""
+from __future__ import annotations
+
+import importlib
+import pkgutil
+from pathlib import Path
+
+# The interface §3.2 specifies. A module missing any of these is incomplete,
+# not merely quieter: every consumer calls every one of them, so an absent name
+# surfaces as an AttributeError inside a render loop rather than as "this
+# module is not finished".
+_REQUIRED_ATTRS = ("NAME", "REQUIRES", "POOLS", "SCHEMA",
+                   "declare", "allocate", "applies_to",
+                   "config_db", "frr_conf", "expected", "observe")
+
+_CACHE = None
+
+
+def discover():
+    """Every feature module in this directory, keyed by NAME.
+
+    Scanned, not listed. Cached because this runs inside derive(), which every
+    consumer calls, and re-importing per device at 124 devices is not free.
+    """
+    global _CACHE
+    if _CACHE is not None:
+        return _CACHE
+    mods = {}
+    here = Path(__file__).resolve().parent
+    for info in pkgutil.iter_modules([str(here)]):
+        if info.name.startswith("_"):
+            continue
+        mod = importlib.import_module(f"{__name__}.{info.name}")
+        missing = [a for a in _REQUIRED_ATTRS if not hasattr(mod, a)]
+        if missing:
+            raise ImportError(
+                f"feature module {info.name!r} is missing {missing}. Every "
+                f"module must implement the whole interface; a partial module "
+                f"renders on some paths and silently not on others.")
+        if mod.NAME != info.name:
+            raise ImportError(
+                f"feature module {info.name!r} declares NAME={mod.NAME!r}. The "
+                f"filename IS the profile key, so they must agree — otherwise a "
+                f"profile can name a feature no scan will ever find.")
+        mods[mod.NAME] = mod
+    _CACHE = mods
+    return mods
+
+
+def names():
+    """The allow-list. Computed from what is on disk, never maintained."""
+    return tuple(sorted(discover()))
